# Copy this file to ".env" and fill in your real values. .env is gitignored — never commit it.
#
# 1. Create a Notion internal integration:  https://www.notion.so/my-integrations
#    -> "New integration" -> internal -> copy the secret (starts with "ntn_" or "secret_").
# 2. Share EACH database with the integration:
#    open the database (full page) -> ••• menu -> Connections -> add your integration.
#    (This is the step everyone forgets — without it the API returns nothing.)
# 3. Get each database ID from its URL:
#    notion.so/<workspace>/<32-char-DATABASE-ID>?v=<view-id>   <- the 32 chars before "?v="

NOTION_TOKEN=your_integration_secret_here
TRADES_DB_ID=your_trades_database_id_here
EXECUTIONS_DB_ID=your_executions_database_id_here
STOCKS_DB_ID=your_stocks_database_id_here

# Optional — the Watchlist screen works without it, just shows a setup notice.
WATCHLIST_DB_ID=your_watchlist_database_id_here
